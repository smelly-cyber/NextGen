// Windows executable icon. IDI_ICON1 as the first icon makes Explorer / the
// taskbar use it as the application icon.
IDI_ICON1 ICON "nextgen_tweaks.ico"

// Version / name information shown by Windows in the file's Properties -> Details
// tab and as the friendly name in Task Manager. Keep FILEVERSION / PRODUCTVERSION
// and the version strings in step with setApplicationVersion() in src/main.cpp
// when cutting a release.
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NextGen Tweaks"
            VALUE "FileDescription", "NextGen Tweaks"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "NextGen Tweaks"
            VALUE "LegalCopyright", "\251 NextGen Tweaks"
            VALUE "OriginalFilename", "NextGenTweaks.exe"
            VALUE "ProductName", "NextGen Tweaks"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
